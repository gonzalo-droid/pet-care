<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Solo en debug: el CI programa un aviso de prueba sin tocar la pantalla (D26). -->
        <receiver
            android:name=".DebugTestReminderReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="com.bestid.app.debug.SCHEDULE_TEST_REMINDER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
