// Equipo de Apple Developer: va en Secrets.xcconfig (no se versiona). Copia Secrets.xcconfig.example.
TEAM_ID=
#include? "Secrets.xcconfig"
// Identificador de la app (D45). Debe ser exactamente este en App Store Connect.
BUNDLE_ID=com.nekodojo.bestid
APP_NAME=BestID

// Versión visible y número de compilación: copia de app-versionName / app-versionCode de
// gradle/libs.versions.toml. `./gradlew check` falla si no coinciden (checkIosVersion).
MARKETING_VERSION=0.6.0
CURRENT_PROJECT_VERSION=4
